{
  "name": "sidekick-ai",
  "version": "0.0.0",
  "private": true,
  "description": "Sidekick AI - Chrome MV3 chat-bot sidebar (parity voi Edge Copilot + Chrome Gemini)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "concurrently -n ext,server -c cyan,magenta \"pnpm dev:ext\" \"pnpm dev:server\"",
    "dev:ext": "pnpm --filter @sidekick/extension dev",
    "dev:server": "pnpm --filter @sidekick/server dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "build:ext": "pnpm --filter @sidekick/extension build",
    "build:server": "pnpm --filter @sidekick/server build",
    "db:migrate": "pnpm --filter @sidekick/server db:migrate",
    "db:generate": "pnpm --filter @sidekick/server db:generate",
    "db:studio": "pnpm --filter @sidekick/server db:studio",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:coverage": "pnpm -r --workspace-concurrency=1 test:coverage",
    "test:e2e": "pnpm --filter @sidekick/extension test:e2e",
    "eval:run": "pnpm --filter @sidekick/eval run",
    "verify:providers": "node scripts/verify-providers.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
