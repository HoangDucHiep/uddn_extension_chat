{
  "$schema": "https://design-tokens.org/schema.json",
  "version": "2.0.0",
  "description": "Sidekick AI design tokens — nguon su that, sinh ra design/tokens.css. Phong cach: flat / trung tinh / hairline (T-M3-POLISH).",
  "color": {
