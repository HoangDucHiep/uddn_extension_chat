      "text-inverse": "#ffffff",
      "success": "#059669",
      "success-subtle": "#ecfdf5",
      "warning": "#d97706",
      "warning-subtle": "#fffbeb",
      "danger": "#dc2626",
      "danger-subtle": "#fef2f2",
      "info": "#2563eb",
      "info-subtle": "#eff6ff",
      "citation-bg": "#f3f4f6",
      "citation-border": "#d1d5db",
      "citation-link": "#374151",
      "citation-hover": "#e5e7eb",
      "code-bg": "#171717",
      "code-border": "#2e2e30",
      "code-fg": "#e5e7eb",
      "code-token-keyword": "#22d3ee",
      "code-token-string": "#86efac",
      "code-token-number": "#fdba74",
      "code-token-comment": "#6b7280",
      "code-token-function": "#60a5fa",
      "code-token-punctuation": "#9ca3af",
      "chip-tint-mint": "#ecfdf5",
      "chip-tint-amber": "#fffbeb",
      "chip-tint-lavender": "#eef2ff",
      "chip-tint-sky": "#eff6ff"
    },
    "dark": {
      "accent": "#e5e7eb",
      "accent-hover": "#ffffff",
      "accent-subtle": "#262626",
      "accent-fg": "#111112",
      "accent-contrast": "#111112",
      "surface-panel": "#111112",
      "surface-raised": "#1a1a1b",
      "surface-sunken": "#1c1c1e",
      "surface-overlay": "#1c1c1e",
      "surface-user-bubble": "#1e2230",
      "border-default": "#2e2e30",
      "border-strong": "#3f3f46",
      "border-subtle": "#262626",
      "border-focus": "#e5e7eb",
      "text-primary": "#f9fafb",
      "text-secondary": "#a1a1aa",
      "text-tertiary": "#71717a",
      "text-inverse": "#111112",
      "success": "#34d399",
      "success-subtle": "#052e26",
      "warning": "#fbbf24",
      "warning-subtle": "#3b2f0b",
      "danger": "#f87171",
      "danger-subtle": "#3f1414",
      "info": "#60a5fa",
      "info-subtle": "#0c2545",
      "citation-bg": "#262626",
      "citation-border": "#3f3f46",
      "citation-link": "#d4d4d8",
      "citation-hover": "#2e2e30",
      "code-bg": "#0d0d0d",
      "code-border": "#262628",
      "code-fg": "#e5e7eb",
      "code-token-keyword": "#22d3ee",
      "code-token-string": "#86efac",
      "code-token-number": "#fdba74",
      "code-token-comment": "#6b7280",
      "code-token-function": "#60a5fa",
      "code-token-punctuation": "#9ca3af",
      "chip-tint-mint": "#052e26",
      "chip-tint-amber": "#3b2f0b",
      "chip-tint-lavender": "#1e1b4b",
      "chip-tint-sky": "#0c2545"
    }
  },
  "typography": {
    "font-sans": "Inter, ui-sans-serif, system-ui, -apple-system, sans-serif",
    "font-mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
    "font-size-xs": "11px",
    "font-size-sm": "12px",
    "font-size-md": "14px",
    "font-size-lg": "15px",
    "font-size-xl": "20px",
    "line-height-tight": "1.3",
    "line-height-base": "1.6",
    "line-height-relaxed": "1.7",
    "font-weight-regular": "400",
    "font-weight-medium": "500",
    "font-weight-semibold": "600",
    "font-scale": "1"
  },
  "spacing": {
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "20px",
    "space-6": "24px",
    "space-7": "32px",
    "space-8": "40px"
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "full": "9999px"
  },
  "elevation": {
    "shadow-1": "0 0 0 0 rgb(0 0 0 / 0)",
    "shadow-2": "0 1px 2px 0 rgb(0 0 0 / 0.06)",
    "shadow-3": "0 8px 24px -8px rgb(0 0 0 / 0.18)"
  },
  "borderWidth": {
    "hairline": "1px",
    "normal": "1px",
    "strong": "2px"
  },
  "motion": {
    "duration-fast": "120ms",
    "duration-base": "200ms",
    "duration-slow": "320ms",
    "ease-standard": "cubic-bezier(0.2, 0, 0, 1)",
    "ease-out": "cubic-bezier(0, 0, 0.2, 1)",
    "ease-in-out": "ease-in-out"
  },
  "focus": {
    "focus-ring": "0 0 0 2px var(--surface-panel), 0 0 0 4px var(--border-focus)",
    "focus-ring-offset": "2px"
  },
  "layout": {
    "panel-min-width": "320px",
    "panel-max-width": "640px",
    "header-height": "52px",
    "composer-min-height": "44px",
    "composer-max-height": "240px",
    "gutter": "12px",
    "message-max-width": "100%"
  }
}
