{
  "$schema": "https://design-tokens.org/schema.json",
  "version": "1.0.0",
  "description": "Sidekick AI design tokens — nguon su that, sinh ra design/tokens.css",
  "color": {
    "light": {
      "accent": "#4f46e5",
      "accent-hover": "#4338ca",
      "accent-subtle": "#eef2ff",
      "accent-fg": "#ffffff",
      "surface-panel": "#ffffff",
      "surface-raised": "#f9fafb",
      "surface-sunken": "#f3f4f6",
      "surface-overlay": "#ffffff",
      "border-default": "#e5e7eb",
      "border-strong": "#d1d5db",
      "border-subtle": "#f3f4f6",
      "border-focus": "#4f46e5",
      "text-primary": "#111827",
      "text-secondary": "#4b5563",
      "text-tertiary": "#9ca3af",
      "text-inverse": "#ffffff",
      "success": "#059669",
      "success-subtle": "#ecfdf5",
      "warning": "#d97706",
      "warning-subtle": "#fffbeb",
      "danger": "#dc2626",
      "danger-subtle": "#fef2f2",
      "info": "#2563eb",
      "info-subtle": "#eff6ff",
      "citation-bg": "#f5f3ff",
      "citation-border": "#c4b5fd",
      "citation-link": "#6d28d9",
      "citation-hover": "#ede9fe",
      "code-bg": "#f9fafb",
      "code-border": "#e5e7eb",
      "code-fg": "#1f2937",
      "code-token-keyword": "#7c3aed",
      "code-token-string": "#059669",
      "code-token-number": "#d97706",
      "code-token-comment": "#9ca3af",
      "code-token-function": "#2563eb",
      "code-token-punctuation": "#6b7280"
    },
    "dark": {
      "accent": "#818cf8",
      "accent-hover": "#a5b4fc",
      "accent-subtle": "#1e1b4b",
      "accent-fg": "#0b1020",
      "surface-panel": "#0b1020",
      "surface-raised": "#141a2e",
      "surface-sunken": "#070b16",
      "surface-overlay": "#141a2e",
      "border-default": "#1f2937",
      "border-strong": "#374151",
      "border-subtle": "#111827",
      "border-focus": "#818cf8",
      "text-primary": "#f3f4f6",
      "text-secondary": "#d1d5db",
      "text-tertiary": "#6b7280",
      "text-inverse": "#0b1020",
      "success": "#34d399",
      "success-subtle": "#052e26",
      "warning": "#fbbf24",
      "warning-subtle": "#3b2f0b",
      "danger": "#f87171",
      "danger-subtle": "#3f1414",
      "info": "#60a5fa",
      "info-subtle": "#0c2545",
      "citation-bg": "#1e1b4b",
      "citation-border": "#4338ca",
      "citation-link": "#c4b5fd",
      "citation-hover": "#2e2a63",
      "code-bg": "#070b16",
      "code-border": "#1f2937",
      "code-fg": "#e5e7eb",
      "code-token-keyword": "#c4b5fd",
      "code-token-string": "#6ee7b7",
      "code-token-number": "#fcd34d",
      "code-token-comment": "#6b7280",
      "code-token-function": "#93c5fd",
      "code-token-punctuation": "#9ca3af"
    }
  },
  "typography": {
    "font-sans": "Inter, ui-sans-serif, system-ui, -apple-system, sans-serif",
    "font-mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
    "font-size-xs": "11px",
    "font-size-sm": "12px",
    "font-size-md": "13px",
    "font-size-lg": "15px",
    "font-size-xl": "18px",
    "line-height-tight": "1.3",
    "line-height-base": "1.5",
    "line-height-relaxed": "1.7",
    "font-weight-regular": "400",
    "font-weight-medium": "500",
    "font-weight-semibold": "600",
    "font-scale": "1"
  },
  "spacing": {
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "20px",
    "space-6": "24px",
    "space-7": "32px",
    "space-8": "40px"
  },
  "radius": {
    "sm": "4px",
    "md": "6px",
    "lg": "10px",
    "full": "9999px"
  },
  "elevation": {
    "shadow-1": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
    "shadow-2": "0 4px 12px -2px rgb(0 0 0 / 0.12)",
    "shadow-3": "0 12px 32px -8px rgb(0 0 0 / 0.24)"
  },
  "borderWidth": {
    "hairline": "1px",
    "normal": "1px",
    "strong": "2px"
  },
  "motion": {
    "duration-fast": "120ms",
    "duration-base": "200ms",
    "duration-slow": "320ms",
    "ease-standard": "cubic-bezier(0.2, 0, 0, 1)",
    "ease-out": "cubic-bezier(0, 0, 0.2, 1)",
    "ease-in-out": "ease-in-out"
  },
  "focus": {
    "focus-ring": "0 0 0 2px var(--surface-panel), 0 0 0 4px var(--border-focus)",
    "focus-ring-offset": "2px"
  },
  "layout": {
    "panel-min-width": "320px",
    "panel-max-width": "640px",
    "header-height": "48px",
    "composer-min-height": "48px",
    "composer-max-height": "240px",
    "gutter": "12px",
    "message-max-width": "100%"
  }
}
