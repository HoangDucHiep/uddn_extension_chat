# ===== Sidekick AI — BFF local config =====
# Copy file nay thanh `.env` roi dien key that vao.
#   cp apps/server/.env.example apps/server/.env
# `.env` da duoc git-ignore — KHONG BAO GIO COMMIT KEY THAT.

# --- Server ---
NODE_ENV=development
PORT=8787
HOST=127.0.0.1

# --- Database (Postgres 16 + pgvector qua docker compose) ---
DATABASE_URL=postgresql://sidekick:change_me@localhost:5432/sidekick
PGPASSWORD=change_me

# --- Security ---
# 32 byte hex (64 ky tu) cho AES-256-GCM. Sinh bang:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# --- CORS / Origin allowlist ---
# Danh sach origin duoc phep goi BFF, phan tach bang dau phay.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Provider: K1 team keys (M0) ---
# Provider mac dinh: groq -> openrouter -> gemini
DEFAULT_PROVIDER=groq
PROVIDER_FALLBACKS=openrouter,gemini

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest

# --- Logging ---
LOG_REQUESTS=false
LOG_LEVEL=info
