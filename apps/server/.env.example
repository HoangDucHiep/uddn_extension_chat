# ===== Sidekick AI — BFF local config =====
# Copy file nay thanh `.env` roi dien key that vao.
#   cp apps/server/.env.example apps/server/.env
# `.env` da duoc git-ignore — KHONG BAO GIO COMMIT KEY THAT.

# --- Server ---
NODE_ENV=development
PORT=8787
HOST=127.0.0.1

# --- Database (Postgres 16 + pgvector qua docker compose) ---
DATABASE_URL=postgresql://sidekick:change_me@localhost:5432/sidekick
PGPASSWORD=change_me

# --- Security ---
# 32 byte hex (64 ky tu) cho AES-256-GCM. Sinh bang:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# --- CORS / Origin allowlist ---
# Danh sach origin duoc phep goi BFF, phan tach bang dau phay.
# `chrome-extension://*` cho phep moi id extension load unpacked (id doi theo may).
# KHONG dung `*` — cho phep toan bo web page goi BFF.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,chrome-extension://*

# --- Provider: K1 team keys (M0) ---
# Provider mac dinh: groq -> openrouter -> gemini
DEFAULT_PROVIDER=groq
PROVIDER_FALLBACKS=openrouter,gemini

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-flash-lite-latest

# --- Logging ---
# Ghi 1 dong `request_logs` cho moi luot chat (chi metadata: provider · model ·
# token · cost · ttft · latency · context_hash).
LOG_REQUESTS=true
# Luu them prompt + response DAY DU vao log (chua noi dung nguoi dung).
# mac dinh TAT — chi bat khi can truy viet chi tiet.
LOG_FULL_CONTENT=false
# So ngay giu lai `request_logs` (retention policy docs/SYSTEM_DESIGN.md §5.2).
# 0 = giu vinh vien.
LOG_RETENTION_DAYS=90
LOG_LEVEL=info
